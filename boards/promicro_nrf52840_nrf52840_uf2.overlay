/* Application-only UF2 layout; the existing MBR/S140 are not build outputs. */
#include "promicro_nrf52840_nrf52840.overlay"

/* Public marker uses the final 16 bytes. Zephyr's ARM linker uses KiB units,
 * so exclude the whole final KiB from app allocations/stacks. The independent
 * boot linker excludes only the marker. The wipe still covers all 256 KiB. */
&sram0 {
	reg = <0x20000000 0x3fc00>;
	ranges = <0x0 0x20000000 0x3fc00>;
};

&code_partition {
	reg = <0x26000 0xba000>;
};

&boot_partition {
	reg = <0xf4000 0xa000>;
};

&flash0 {
	partitions {
		factory_backup_partition: partition@e0000 {
			label = "factory-backup";
			reg = <0xe0000 0xc000>;
		};

		mbr_params_partition: partition@fe000 {
			label = "mbr-params";
			reg = <0xfe000 0x1000>;
			read-only;
		};

		boot_settings_partition: partition@ff000 {
			label = "boot-settings";
			reg = <0xff000 0x1000>;
			read-only;
		};
	};
};
